{
  "name": "multiverse-mages",
  "version": "0.3.0",
  "private": true,
  "description": "Multiverse Mages — a real-time strategy game in which the player is the god of magic for a universe.",
  "license": "AGPL-3.0-or-later",
  "author": "Ann Kelner",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "check:purity": "node scripts/check-purity.mjs",
    "goldens:regen": "node --experimental-strip-types scripts/regen-goldens.mjs",
    "check:content": "node packages/content/bin/validate-content.mjs",
    "check:audio": "node packages/content/bin/validate-audio.mjs",
    "check:coverage": "node scripts/check-primitive-coverage.mjs",
    "check:consumption": "node scripts/check-primitive-consumption.mjs",
    "check:reachability": "node scripts/check-reachability.mjs",
    "content:map": "node scripts/content-graph.mjs --format map",
    "content:graph": "node scripts/content-graph.mjs --format html",
    "audio:generate": "node scripts/generate-audio.mjs",
    "audio:manifest": "node scripts/audition-manifest.mjs",
    "audition": "node scripts/audition-server.mjs",
    "test": "vitest run",
    "balance:gate": "node packages/mc-harness/bin/balance-gate.mjs --scenario ./packages/scenario/bin/scenario.mjs --sweep ./balance/sweeps/balance-gate.sweep.json --baseline ./balance/baselines/balance-gate-v1.baseline.json --workers 4",
    "prebalance:gate": "npm run typecheck",
    "balance:gate:horizon": "node packages/mc-harness/bin/balance-gate.mjs --scenario ./packages/scenario/bin/scenario.mjs --sweep ./balance/sweeps/balance-gate-horizon.sweep.json --baseline ./balance/baselines/balance-gate-horizon-v1.baseline.json --workers 4",
    "prebalance:gate:horizon": "npm run typecheck",
  "balance:gate:agency": "node packages/mc-harness/bin/balance-gate.mjs --scenario ./packages/scenario/bin/scenario.mjs --sweep ./balance/sweeps/balance-gate-agency.sweep.json --baseline ./balance/baselines/balance-gate-agency-v1.baseline.json --workers 4",
  "prebalance:gate:agency": "npm run typecheck",
    "balance:gate:ascension": "node packages/mc-harness/bin/balance-gate.mjs --scenario ./packages/scenario/bin/scenario.mjs --sweep ./balance/sweeps/balance-gate-ascension.sweep.json --baseline ./balance/baselines/balance-gate-ascension-v1.baseline.json --workers 4",
    "prebalance:gate:ascension": "npm run typecheck",
    "test:watch": "vitest",
    "bench": "tsc -p packages/sim-core/bench/tsconfig.run.json && node scripts/bench.mjs",
    "verify:nosweeps": "npm run typecheck && npm run lint && npm run check:purity && npm run check:content && npm run check:audio && npm run check:coverage && npm run test",
    "verify": "npm run typecheck && npm run lint && npm run check:purity && npm run check:content && npm run check:audio && npm run check:coverage && npm run test && npm run balance:gate && npm run balance:gate:horizon && npm run balance:gate:agency",
  "verify:full": "npm run verify && npm run balance:gate:ascension",
    "ui": "npx --yes http-server . -p 8200 --no-dotfiles -c-1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
