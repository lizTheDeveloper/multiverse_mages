{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Typechecks the unit tests and the golden suite. Never emits into dist/.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./test",
    "types": ["node"],
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/sim-core-test",
    "tsBuildInfoFile": "../../.tsbuild/sim-core-test.tsbuildinfo"
  },
  "include": ["test/**/*.ts"],
  "references": [{ "path": "./tsconfig.json" }]
}
