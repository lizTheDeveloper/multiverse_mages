{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Library build. `types: []` is deliberate — the core must not see Node's ambient types.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": []
  },
  "include": ["src/**/*.ts"]
}
