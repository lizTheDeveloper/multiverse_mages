{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-mages.invalid/schema/audio/voice-line.schema.json",
  "title": "voice-line.json",
  "description": "Bark banks (docs/design/sound-design.md §8). Renderer-only content: never loaded by the simulation, never part of contentRevision. Text is CC BY-SA 4.0 per ASSET-LICENSE.md.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/bank"
  },
  "$defs": {
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "speaker",
        "speakerKind",
        "voiceId",
        "voicePrompt",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "speaker": {
          "$ref": "#/$defs/contentId"
        },
        "speakerKind": {
          "enum": [
            "species",
            "populace",
            "populace-flavour"
          ],
          "description": "species: a mage of that species, with the full escalation structure. populace: an occupation, spoken by any species. populace-flavour: a non-mage OF a species — contracts §1.3 keys every cohort by species AND occupation, so a dwarf laborer and an orc laborer are different cohorts and should not say the same words. The occupation is carried in each line's `about`."
        },
        "voiceId": {
          "type": "string",
          "maxLength": 64,
          "description": "Text-to-speech voice for this bank. Empty means deliberately unassigned; the generator refuses such a bank by name rather than silently using a fallback voice for it."
        },
        "voicePrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "text",
        "about"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "tier": {
          "enum": [
            "selection",
            "acknowledgement",
            "annoyance-polite",
            "annoyance-irritated",
            "annoyance-cracking",
            "annoyance-unhinged",
            "breakthrough",
            "blessed",
            "death",
            "last-copy",
            "cross-species",
            "flavour"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "about": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "contentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    }
  }
}
