{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse-mages.invalid/schema/territory.schema.json",
  "title": "territory.json",
  "description": "The regions a universe is made of (contracts.md §2.7). Their summed `landUnits × capacityPerLandUnit` is the fixed resource carrying capacity is derived from, and is the only term in `K` that no in-run process can grow.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/territory" },
  "$defs": {
    "territory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "gloss", "landUnits", "capacityPerLandUnit", "tuningStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gloss": { "type": "string", "minLength": 1, "maxLength": 400 },
        "landUnits": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "capacityPerLandUnit": { "$ref": "#/$defs/fp" },
        "tuningStatus": { "type": "string", "enum": ["untuned", "tuned"] }
      }
    },
    "fp": { "type": "integer", "minimum": 1, "maximum": 1073741823 },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
