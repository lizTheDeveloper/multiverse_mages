{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Library build. Unlike sim-core this package reads files, so it sees Node's ambient types.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
