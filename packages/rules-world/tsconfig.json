{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Library build. `types: []` is deliberate — rules-path code must run unchanged in Node, Electron, and a browser, so it must not see Node's ambient types.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../sim-core" }, { "path": "../content" }, { "path": "../primitives" }]
}
