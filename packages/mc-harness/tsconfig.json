{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Library build. Unlike the rules packages this one owns worker processes and file output, so it sees Node's ambient types.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../agent-api" }]
}
