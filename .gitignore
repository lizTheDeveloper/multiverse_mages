node_modules/
dist/
.DS_Store
*.log
mc-results/
.tsbuild/
*.tsbuildinfo
coverage/

# agent worktrees
.claude/worktrees/

# secrets — never commit; this repo is public
.env
.env.*
!.env.example

.playwright-mcp/

# Generated audio candidates. Selected takes are committed under assets/selected/.
assets/candidates/

# Superseded takes from a voice recast. Kept on disk so a swap is reversible
# with one `mv`, but they are regenerable audio and do not belong in history.
assets/retired/

# Python bytecode, from packages/gym-bridge/python.
__pycache__/
*.py[cod]
.w15/
# W17 measurement output. Same reason .w15/ is ignored: a sweep writes tens of
# thousands of lines of JSON per arm and none of it is source.
.w17/

# The generated lattice report from scripts/content-graph.mjs. Named exactly
# rather than globbed: `ui/*.html` also matched the hand-authored ui/index.html,
# and `git add` says nothing when an ignore rule eats a file you meant to commit.
# That shipped a README advertising a front door that was not in the repository.
ui/lattices.html
